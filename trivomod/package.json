{
  "name": "trivomod",
  "version": "0.1.4",
  "private": true,
  "description": "Mod de cliente para o Trivo Desktop: temas, CSS próprio e plugins visuais.",
  "bin": {
    "trivomod": "bin/trivomod.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "install-mod": "node bin/trivomod.js install",
    "uninstall-mod": "node bin/trivomod.js uninstall",
    "status": "node bin/trivomod.js status"
  },
  "engines": {
    "node": ">=18"
  }
}
